# Only what the build reads, so that a commit changing nothing else, such as the tests, reuses the cached build.
# .github/workflows/agentctl-image.yml lists the same paths to name a main build after its newest commit to them.
*
!.cargo/config.toml
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!agentctl/Cargo.toml
!agentctl/build.rs
!agentctl/src/
!agentctl/skills/
# The standard agents agentctl embeds; their image build inputs are left out.
!agents/standard/
agents/standard/**/Dockerfile
agents/standard/**/.dockerignore
!sandbox/authorization/Cargo.toml
!sandbox/authorization/src/
!sandbox/core/Cargo.toml
!sandbox/core/src/
!sandbox/microsandbox/Cargo.toml
!sandbox/microsandbox/src/
!sandbox/core/examples/worktree/Cargo.toml
!sandbox/core/examples/worktree/src/
