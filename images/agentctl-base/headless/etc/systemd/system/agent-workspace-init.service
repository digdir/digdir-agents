[Unit]
Description=Clone the Agent workspace repositories
Wants=network-online.target
After=network-online.target
ConditionDirectoryNotEmpty=/etc/agent-workspace.d

[Service]
# Best-effort clones started at boot of the repositories /etc/agent-workspace.d lists; a checkout
# that already has `.git` is left alone. `Type=exec` completes the start job once the script has
# been started, keeping the clone out of the boot transaction so that
# `systemctl is-system-running --wait` does not wait for it.
Type=exec
User=agent
Group=agent
Environment=HOME=/home/agent
PassEnvironment=GITHUB_TOKEN
ExecStart=/usr/local/libexec/agent-workspace-init

[Install]
WantedBy=multi-user.target
