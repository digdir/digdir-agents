#!/bin/sh
set -eu

# Clones the GitHub repositories listed in /etc/agent-workspace.d/*.list into the workspace. Each
# line names one repository as OWNER/NAME, optionally followed by a destination below
# /home/agent/code, which defaults to NAME; `#` starts a comment. A destination that already has
# `.git`, such as a bind-mounted host checkout, is left alone.
lists=${AGENT_WORKSPACE_LISTS:-/etc/agent-workspace.d}
workspace=/home/agent/code

missing=
for list in "$lists"/*.list; do
    [ -f "$list" ] || continue
    # The `|| [ -n "$line" ]` keeps a last line without a newline.
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%%#*}
        # shellcheck disable=SC2086 # Splits the line into its fields, without expanding globs.
        set -f
        set -- $line
        set +f
        [ "$#" -gt 0 ] || continue
        repository=$1
        destination=${2:-${repository#*/}}
        if [ ! -e "$workspace/$destination/.git" ]; then
            missing="$missing $repository=$destination"
        fi
    done <"$list"
done
if [ -z "$missing" ]; then
    exit 0
fi
mkdir -p "$workspace"

# Guest boot can race the host-mediated network handshake. Wait for DNS,
# while leaving each repository operation itself as one best-effort attempt.
remaining=30
while ! /usr/bin/getent ahosts github.com >/dev/null 2>&1; do
    if [ "$remaining" -eq 0 ]; then
        echo "github.com did not become resolvable within 30 seconds" >&2
        exit 1
    fi
    remaining=$((remaining - 1))
    /usr/bin/sleep 1
done

# Clones one repository beside its destination and moves it into place only once it is complete,
# so that an interrupted clone never leaves a destination with `.git`, which every later boot
# would skip. A clone a Session made at the destination in the meantime is kept instead.
clone() {
    repository=$1
    destination=$2
    partial=$destination.partial
    rm -rf "$partial"
    # When the repository is a fork, gh adds its parent as `upstream`, and `gh pr create` and
    # `gh issue` then target the parent. The listed repository is the one the Agent works in.
    if ! /usr/local/bin/gh repo clone "$repository" "$partial" \
        || ! (cd "$partial" && /usr/local/bin/gh repo set-default "$repository"); then
        rm -rf "$partial"
        return 1
    fi
    mv -T "$partial" "$destination" 2>/dev/null && return 0
    rm -rf "$partial"
    if [ ! -e "$destination/.git" ]; then
        echo "$destination exists and is not a clone; leaving it alone" >&2
        return 1
    fi
}

status=0
for entry in $missing; do
    destination="$workspace/${entry#*=}"
    mkdir -p "${destination%/*}"
    clone "${entry%%=*}" "$destination" || status=1
done
exit "$status"
