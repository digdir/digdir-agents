[Unit]
Description=Window manager and panel for the Agent desktop
Before=multi-user.target
After=agent-desktop-display.service
Requires=agent-desktop-display.service

[Service]
Type=exec
User=agent
Group=agent
Environment=HOME=/home/agent
EnvironmentFile=/etc/agent-desktop.conf
EnvironmentFile=-/etc/agent-desktop.conf.d/*.conf
ExecStart=/usr/local/libexec/agent-desktop-session
# What a person starts from the desktop, such as a terminal from the panel and the build in it, runs
# in this unit. Under systemd's default OOMPolicy=stop, one OOM kill among them would stop the
# window manager and close every window; with `continue` the killed process is the only casualty.
OOMPolicy=continue
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
