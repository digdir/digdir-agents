#!/bin/sh
# Starts the Agent desktop session: the configured keyboard layout, a panel, a window manager.
set -eu

: "${AGENT_DESKTOP_DISPLAY:=:1}"
: "${AGENT_DESKTOP_KEYBOARD:=us}"
export DISPLAY="$AGENT_DESKTOP_DISPLAY"
# xdotool decodes text with the locale's character set and refuses multi-byte input under the
# POSIX locale, so without this the desktop cannot type æ, ø or å.
export LC_ALL="${LC_ALL:-C.UTF-8}"

for _ in $(seq 1 100); do
    xdpyinfo >/dev/null 2>&1 && break
    sleep 0.1
done
xdpyinfo >/dev/null 2>&1 || { echo "desktop session: $DISPLAY never came up" >&2; exit 1; }

# The layout is what a person typing over VNC gets. `desktop type` binds what the layout lacks
# itself, so it does not depend on this. A layout setxkbmap rejects leaves the keyboard as it was,
# US on a fresh display, rather than a desktop that never starts.
# shellcheck disable=SC2086 # AGENT_DESKTOP_KEYBOARD holds setxkbmap arguments, such as `us -variant intl`.
setxkbmap $AGENT_DESKTOP_KEYBOARD \
    || echo "desktop session: setxkbmap $AGENT_DESKTOP_KEYBOARD failed; the keyboard layout is unchanged" >&2

# -c pins the configuration to the image: without it tint2 copies its template into the home
# directory, which the platform resynchronizes from the host on every Sandbox setup.
tint2 -c /etc/xdg/tint2/tint2rc >/dev/null 2>&1 &
exec openbox
