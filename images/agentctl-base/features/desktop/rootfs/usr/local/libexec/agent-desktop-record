#!/usr/bin/env python3
"""Records the whole desktop for someone to watch.

Called by `desktop record`, which passes the file that holds the running recording's state.

    agent-desktop-record STATE start OUT.mp4
    agent-desktop-record STATE stop [--width PIXELS]

`start` captures the display in the background, lightly compressed so that capturing keeps up. `stop` ends the
capture and renders OUT.mp4 at the width asked for. The state file is one line, `FFMPEG_PID WIDTH HEIGHT OUT`, which
the helper reads too.
"""

import fcntl
import os
import re
import shutil
import signal
import subprocess
import sys
import time

FPS = 25


def fail(message):
    print(f'desktop: record: {message}', file=sys.stderr)
    sys.exit(1)


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    return True


def read_state(state):
    try:
        with open(state) as f:
            ffmpeg, width, height, out = f.read().rstrip('\n').split(' ', 3)
    except FileNotFoundError:
        fail('no recording is running; start one with `desktop record start OUT.mp4`')
    return int(ffmpeg), int(width), int(height), out


def parts_dir(out):
    """Where the raw capture and its log are kept until the recording is rendered."""
    return os.path.splitext(out)[0] + '.parts'


def start(state, out):
    if not out.endswith('.mp4'):
        fail(f'the recording must be an .mp4 file, got {out!r}')
    # Held until the recording is running, so that of two starts at once only one goes on, rather than both starting
    # a recorder and one of them losing track of it.
    with open(state + '.lock', 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fail('another recording is starting')
        begin(state, out)


def begin(state, out):
    if os.path.exists(state):
        if alive(read_state(state)[0]):
            fail('a recording is already running; stop it with `desktop record stop`')
        os.remove(state)
    out = os.path.abspath(out)
    parts = parts_dir(out)
    shutil.rmtree(parts, ignore_errors=True)
    os.makedirs(parts)
    geometry = subprocess.run(['xdpyinfo'], check=True, capture_output=True, text=True).stdout
    width, height = map(int, re.search(r'dimensions:\s+(\d+)x(\d+)', geometry).groups())
    with open(os.path.join(parts, 'ffmpeg.log'), 'w') as log:
        ffmpeg = subprocess.Popen(
            ['ffmpeg', '-hide_banner', '-y', '-f', 'x11grab', '-framerate', str(FPS),
             '-video_size', f'{width}x{height}', '-draw_mouse', '1', '-i', os.environ['DISPLAY'],
             '-c:v', 'libx264', '-preset', 'ultrafast', '-crf', '10', os.path.join(parts, 'raw.mkv')],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=log, start_new_session=True)
    with open(state + '.new', 'w') as f:
        f.write(f'{ffmpeg.pid} {width} {height} {out}\n')
    os.replace(state + '.new', state)
    # The grabber needs a moment before its first frame, and the first action should be in the recording.
    time.sleep(1)
    if ffmpeg.poll() is not None:
        os.remove(state)
        fail(f'ffmpeg could not record the display; see {os.path.join(parts, "ffmpeg.log")}')
    print(f'recording the {width}x{height} display into {out}; `desktop record stop` ends it')


def stop(state, out_width):
    ffmpeg, width, height, out = read_state(state)
    # Hold the last frame, so that the result stays on screen once the clip ends.
    time.sleep(0.5)
    if not alive(ffmpeg):
        os.remove(state)
        fail(f'the recording had already ended; see {os.path.join(parts_dir(out), "ffmpeg.log")}')
    os.kill(ffmpeg, signal.SIGINT)
    for _ in range(100):
        if not alive(ffmpeg):
            break
        time.sleep(0.1)
    else:
        fail('ffmpeg did not finish the recording')
    os.remove(state)
    out_width -= out_width % 2
    out_height = round(out_width * height / width / 2) * 2
    subprocess.run(['ffmpeg', '-hide_banner', '-loglevel', 'error', '-y', '-i', os.path.join(parts_dir(out), 'raw.mkv'),
                    '-vf', f'scale={out_width}:{out_height}:flags=lanczos,format=yuv420p', '-c:v', 'libx264',
                    '-crf', '23', '-preset', 'slow', '-movflags', '+faststart', '-an', out], check=True)
    shutil.rmtree(parts_dir(out))
    duration = float(subprocess.run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'csv=p=0',
                                     out], check=True, capture_output=True, text=True).stdout)
    print(f'{out}: {duration:.1f} s, {os.path.getsize(out)} bytes')


def main():
    if len(sys.argv) < 3:
        fail('usage: agent-desktop-record STATE start OUT.mp4 | stop [--width PIXELS]')
    state, command, arguments = sys.argv[1], sys.argv[2], sys.argv[3:]
    if command == 'start' and len(arguments) == 1:
        start(state, arguments[0])
    elif command == 'stop' and not arguments:
        stop(state, 1280)
    elif command == 'stop' and len(arguments) == 2 and arguments[0] == '--width' and arguments[1].isdigit():
        stop(state, int(arguments[1]))
    else:
        fail('takes start OUT.mp4 or stop [--width PIXELS]')


if __name__ == '__main__':
    main()
