#!/usr/bin/env bash
# Drives the Agent's X11 desktop: observe it, point at it, type into it.
#
#   desktop <command> [arguments]
#   desktop help
#
# Coordinates are always in the pixels of the screenshot this helper last sent, never in display
# pixels; when the display is larger than the screenshot budget the helper scales them back itself.
# `desktop tree` reports its boxes in the same pixels. If the display has changed size since the
# last screenshot or tree, pointer commands and those that take or report coordinates refuse
# rather than land somewhere other than what was observed.
# Captures settle before they are written, so a screenshot never shows a half-drawn frame.
set -euo pipefail
# Without this, a failure inside `$(...)` is ignored: a capture whose ffmpeg failed would still be
# reported with a path to a file that does not exist.
shopt -s inherit_errexit

# The image points DISPLAY at the Agent's own desktop; DESKTOP_DISPLAY overrides it for a second
# screen or a test harness.
display=${DESKTOP_DISPLAY:-${DISPLAY:-:1}}
captures=${DESKTOP_CAPTURES:-/tmp/desktop}
# The screenshot budget: how many pixels a screenshot may hold and how long its longest edge may be.
# A larger display is downscaled to fit, so the model reads its image exactly as sent: a harness or
# API that resized it again would put every click the model reads off it somewhere else. The
# budget belongs to the model reading the screenshot, not to the display, and agentd tells each
# Session which harness it runs in AGENT_HARNESS. See budget() below for how settings combine.
budget_harness=${AGENT_HARNESS:-}
# Each vendor's documented resize threshold, below which its harness and API send an image as it
# is. Both count square patches, rounded up on each edge, so each pixel count sits below
# patch area x patch budget by enough that every display from 64x64 to 8000x8000 scaled to it fits.
case $budget_harness in
    claudeCode)
        # Claude Code resizes images itself to the model's limits before sending them, as the
        # API would: 1568 px on the long edge and 1568 patches of 28x28 px on the standard tier,
        # 2576 px and 4784 patches on Claude 4.7 and later. Claude Code can run models on either
        # tier, so this is the standard tier's. 1600x900 is sent at 1445x812, 1508 patches.
        # https://platform.claude.com/docs/en/build-with-claude/vision#resolution-and-token-cost
        # https://platform.claude.com/docs/en/build-with-claude/vision-coordinates
        budget_source=harness table_pixels=1175000 table_edge=1568 ;;
    codex)
        # Codex's view_image resizes to OpenAI's `high` detail, its default, which every model it
        # offers takes as it is: 2048 px on the long edge and 2500 patches of 32x32 px. A model may
        # ask for `original` detail, larger still. 1920x1080 is sent as it is, 2040 patches.
        # https://developers.openai.com/api/docs/guides/images-vision
        # https://github.com/openai/codex/blob/rust-v0.164.0/codex-rs/utils/image/src/lib.rs
        budget_source=harness table_pixels=2457600 table_edge=2048 ;;
    pi)
        # Pi sends images to whichever provider it is configured for, so it gets the default.
        budget_source=harness table_pixels='' table_edge='' ;;
    '') budget_source=default table_pixels='' table_edge='' ;;
    *) budget_source=unknown table_pixels='' table_edge='' ;;
esac
# Without a harness, for a person, an SSH shell or another tool, and for one not in the table: the
# smallest budget of any harness above, so the screenshot fits every model that may read it.
table_pixels=${table_pixels:-1175000}
table_edge=${table_edge:-1568}
# ffmpeg's mjpeg scale: -q:v 7 encodes at JPEG quality 75, the quality Anthropic's reference
# implementation sends. Lower numbers are better quality and larger files.
jpeg_quality=${DESKTOP_JPEG_QUALITY:-7}
# A capture is taken to be settled once two consecutive frames are byte-identical. mjpeg output is
# deterministic, so the second identical frame is itself the screenshot and costs nothing extra.
settle_attempts=${DESKTOP_SETTLE_ATTEMPTS:-8}
settle_interval=${DESKTOP_SETTLE_INTERVAL:-0.1}
keep_captures=${DESKTOP_KEEP_CAPTURES:-200}
# The geometry of the last screenshot or tree, which every coordinate refers to.
observed_geometry=$captures/.screenshot-geometry

export DISPLAY=$display
# xdotool decodes the text it types with the locale's character set, and refuses a multi-byte
# sequence under the POSIX locale: without this, `type` cannot enter æ, ø or å.
export LC_ALL=${LC_ALL:-C.UTF-8}

json=false
fail() { echo "desktop: $*" >&2; exit 1; }

self=$(readlink -f -- "${BASH_SOURCE[0]}")
# Runs one desktop command as its own process. Bash ignores `set -e` in a function called from an
# `if`, `||` or `!` context, and every command ends in `sync_x`, which always succeeds, so a failed
# xdotool call inside such a context would report success. A fresh process has errexit back, and a
# `fail` in it cannot end the caller before the caller has cleaned up.
run_command() {
    if $json; then "$self" --json "$@"; else "$self" "$@"; fi
}

# Captures are JPEG: the settle loop takes two byte-identical frames as proof that the screen has
# stopped changing, and that only holds for one deterministic encoder.
require_jpeg_path() {
    case $1 in
        *.jpg | *.jpeg) ;;
        *) fail "--out must name a .jpg file, got '$1'" ;;
    esac
}

usage() {
    cat <<'USAGE'
desktop <command> [arguments]

Observe
  screenshot [--out PATH]        capture the display, settled, within the screenshot budget
  zoom X Y W H [--out PATH]      capture one region at native resolution
  windows                        list mapped windows with geometry, class and title
  tree [APPLICATION]             what is showing, as an accessibility tree with click boxes
  cursor                         print the pointer position
  display                        print display geometry, the screenshot budget and its source, the keyboard layout

Point
  move X Y                       move the pointer
  click [X Y]                    left click, optionally after moving
  right-click [X Y]              right click
  middle-click [X Y]             middle click
  double-click [X Y]             double click
  triple-click [X Y]             triple click
  mouse-down [BUTTON]            press and hold a button (default 1)
  mouse-up [BUTTON]              release a button (default 1)
  drag X1 Y1 X2 Y2               press at the first point, move, release at the second
  scroll up|down|left|right [N]  scroll N steps (default 3) at the pointer

Type
  type TEXT                      type literal text, any Unicode, whatever the keyboard layout
  key KEYSYM [--repeat N]        press an X11 key combination, for example ctrl+s or Page_Down
  hold-key KEYSYM COMMAND...     hold a modifier while running another desktop command

Windows and session
  focus WINDOW                   raise and focus a window by id or title substring
  resize WIDTH HEIGHT            resize the display with RandR
  wait SECONDS                   pause

Batch
  batch [--no-screenshot]        read one command per line from stdin and run them in order

Options
  --json                         machine-readable output, where a command supports it
USAGE
}

# --- geometry ---------------------------------------------------------------------------------

display_geometry() {
    xdpyinfo | awk '/dimensions:/ { print $2; exit }'
}

# Settles the budget into budget_pixels, budget_edge, budget_width and budget_height, where empty
# means no limit, and budget_overrides, the settings that replaced the harness's budget. Explicit
# settings always win over the table: DESKTOP_SCREENSHOT_PIXELS and DESKTOP_SCREENSHOT_MAX_EDGE
# each replace their half of it. DESKTOP_MAX_WIDTH and DESKTOP_MAX_HEIGHT, the box this helper
# fitted screenshots into before it had a pixel budget, keep that meaning: either one replaces the
# whole budget with a box, whose other side is still 1456 or 819, and only the DESKTOP_SCREENSHOT_*
# settings given beside them still apply as well.
budget() {
    budget_overrides=()
    local name
    for name in DESKTOP_SCREENSHOT_PIXELS DESKTOP_SCREENSHOT_MAX_EDGE DESKTOP_MAX_WIDTH DESKTOP_MAX_HEIGHT; do
        [ -z "${!name:-}" ] && continue
        case ${!name} in *[!0-9]* | 0*) fail "$name must be a positive integer, got '${!name}'" ;; esac
        budget_overrides+=("$name")
    done
    if [ -n "${DESKTOP_MAX_WIDTH:-}${DESKTOP_MAX_HEIGHT:-}" ]; then
        budget_width=${DESKTOP_MAX_WIDTH:-1456}
        budget_height=${DESKTOP_MAX_HEIGHT:-819}
        budget_pixels=${DESKTOP_SCREENSHOT_PIXELS:-}
        budget_edge=${DESKTOP_SCREENSHOT_MAX_EDGE:-}
    else
        budget_width='' budget_height=''
        budget_pixels=${DESKTOP_SCREENSHOT_PIXELS:-$table_pixels}
        budget_edge=${DESKTOP_SCREENSHOT_MAX_EDGE:-$table_edge}
    fi
}

# Prints "display_width display_height sent_width sent_height". The sent size is the display size
# reduced to fit the budget; the model addresses the sent size and never does this arithmetic.
# scale = min(1, sqrt(pixels / (w * h)), edge / max(w, h)), and the box's sides when one is set.
# Sizes round down, so the budget holds; the epsilon keeps a side the box sets exactly from
# losing a pixel to floating point.
geometry() {
    local geometry width height
    geometry=$(display_geometry) || fail "cannot read display $display"
    width=${geometry%x*}
    height=${geometry#*x}
    awk -v w="$width" -v h="$height" -v p="$budget_pixels" -v e="$budget_edge" \
        -v bw="$budget_width" -v bh="$budget_height" 'BEGIN {
        scale = 1
        if (p != "" && w * h > p) scale = sqrt(p / (w * h))
        if (e != "" && e / (w > h ? w : h) < scale) scale = e / (w > h ? w : h)
        if (bw != "" && bw / w < scale) scale = bw / w
        if (bh != "" && bh / h < scale) scale = bh / h
        sw = int(w * scale + 1e-9); sh = int(h * scale + 1e-9)
        printf "%d %d %d %d\n", w, h, (sw < 1 ? 1 : sw), (sh < 1 ? 1 : sh)
    }'
}

# Records the geometry an observation's pixels are in, for addressed_geometry to hold coordinates
# to. Written whole, so that a concurrent command never reads half a record.
record_observed_geometry() {
    mkdir -p "$captures"
    printf '%s %s %s %s\n' "$@" >"$observed_geometry.$$"
    mv -f "$observed_geometry.$$" "$observed_geometry"
}

# Prints the geometry coordinates refer to, in the form geometry() prints: the last observation's,
# or the display's when there has been none. Fails when the display has changed size since that
# observation, because its coordinates would then address somewhere else. Call it as
# `addressed=$(addressed_geometry)`: a failure inside `< <(...)` would not stop the caller.
addressed_geometry() {
    local current width height sent_width sent_height now_width now_height
    current=$(geometry)
    [ -r "$observed_geometry" ] || { echo "$current"; return 0; }
    read -r width height sent_width sent_height <"$observed_geometry"
    read -r now_width now_height _ <<<"$current"
    [ "$width" = "$now_width" ] && [ "$height" = "$now_height" ] \
        || fail "the display changed from ${width}x${height} to ${now_width}x${now_height} since the last screenshot or tree; take a new one"
    echo "$width $height $sent_width $sent_height"
}

# Maps a coordinate from sent-screenshot pixels to display pixels.
to_display() {
    local value=$1 sent=$2 actual=$3
    awk -v v="$value" -v s="$sent" -v a="$actual" 'BEGIN { printf "%d\n", (s == a) ? v : int(v * a / s + 0.5) }'
}

require_integer() {
    case $1 in
        '' | *[!0-9-]*) fail "$2 must be an integer, got '$1'" ;;
    esac
}

# --- capture ----------------------------------------------------------------------------------

grab() {
    # grab OUTPUT REGION_SIZE REGION_OFFSET [SCALE_WIDTH SCALE_HEIGHT]
    local output=$1 size=$2 offset=$3 scale_width=${4:-} scale_height=${5:-}
    local filter=()
    [ -n "$scale_width" ] && filter=(-vf "scale=${scale_width}:${scale_height}:flags=bilinear")
    ffmpeg -hide_banner -loglevel error -y \
        -f x11grab -draw_mouse 1 -video_size "$size" -i "${display}.0+${offset}" \
        -frames:v 1 "${filter[@]}" -q:v "$jpeg_quality" "$output"
}

# Captures repeatedly until two consecutive frames are identical, so the file never holds a
# half-drawn frame. Returns the number of frames it took.
capture_settled() {
    local output=$1 size=$2 offset=$3 scale_width=${4:-} scale_height=${5:-}
    local previous='' current attempt
    local scratch="${output%.*}.settling.jpg"
    for ((attempt = 1; attempt <= settle_attempts; attempt++)); do
        grab "$scratch" "$size" "$offset" "$scale_width" "$scale_height" || fail "cannot capture display $display"
        current=$(cksum <"$scratch" | cut -d' ' -f1)
        if [ "$current" = "$previous" ]; then
            mv -f "$scratch" "$output"
            echo "$attempt"
            return 0
        fi
        previous=$current
        sleep "$settle_interval"
    done
    mv -f "$scratch" "$output"
    echo "$attempt"
}

new_capture_path() {
    mkdir -p "$captures"
    # /tmp is a tmpfs a build also uses. Keep recent captures readable and let the rest go, so a
    # long session, or a loop that screenshots more than it should, cannot fill it.
    # `find` rather than `ls` on a glob: with no capture yet the glob matches nothing, `ls` exits 2,
    # and under pipefail and inherit_errexit that would end every first screenshot silently.
    find "$captures" -maxdepth 1 -name '*.jpg' -printf '%T@ %p\n' | sort -rn \
        | tail -n +"$keep_captures" | cut -d' ' -f2- | xargs -r -d '\n' rm -f --
    printf '%s/%s-%s-%04d.jpg\n' "$captures" "$1" "$(date +%Y%m%d-%H%M%S)" "$((RANDOM % 10000))"
}

report_capture() {
    local path=$1 width=$2 height=$3 frames=$4 note=${5:-}
    if $json; then
        printf '{"path":"%s","width":%d,"height":%d,"frames":%d,"bytes":%d}\n' \
            "$path" "$width" "$height" "$frames" "$(stat -c %s "$path")"
    else
        printf '%s (%dx%d, %d bytes)%s\n' "$path" "$width" "$height" "$(stat -c %s "$path")" "$note"
    fi
}

command_screenshot() {
    local out=''
    while [ $# -gt 0 ]; do
        case $1 in
            --out) out=${2:?--out needs a path}; require_jpeg_path "$2"; shift 2 ;;
            *) fail "screenshot: unexpected argument '$1'" ;;
        esac
    done
    local actual_width actual_height sent_width sent_height note='' frames
    read -r actual_width actual_height sent_width sent_height < <(geometry)
    [ -n "$out" ] || out=$(new_capture_path screen)
    mkdir -p "$(dirname "$out")"
    if [ "$sent_width" != "$actual_width" ]; then
        frames=$(capture_settled "$out" "${actual_width}x${actual_height}" "0,0" "$sent_width" "$sent_height")
        note=" — display is ${actual_width}x${actual_height}; coordinates are in these ${sent_width}x${sent_height} pixels"
    else
        frames=$(capture_settled "$out" "${actual_width}x${actual_height}" "0,0")
    fi
    record_observed_geometry "$actual_width" "$actual_height" "$sent_width" "$sent_height"
    report_capture "$out" "$sent_width" "$sent_height" "$frames" "$note"
}

command_zoom() {
    local x=$1 y=$2 w=$3 h=$4; shift 4
    local out=''
    while [ $# -gt 0 ]; do
        case $1 in
            --out) out=${2:?--out needs a path}; require_jpeg_path "$2"; shift 2 ;;
            *) fail "zoom: unexpected argument '$1'" ;;
        esac
    done
    for pair in "x:$x" "y:$y" "w:$w" "h:$h"; do require_integer "${pair#*:}" "zoom ${pair%%:*}"; done
    local actual_width actual_height sent_width sent_height addressed
    addressed=$(addressed_geometry)
    read -r actual_width actual_height sent_width sent_height <<<"$addressed"
    x=$(to_display "$x" "$sent_width" "$actual_width")
    y=$(to_display "$y" "$sent_height" "$actual_height")
    w=$(to_display "$w" "$sent_width" "$actual_width")
    h=$(to_display "$h" "$sent_height" "$actual_height")
    (( x >= 0 && y >= 0 && x < actual_width && y < actual_height && w > 0 && h > 0 )) \
        || fail "zoom: region must start inside the display"
    (( x + w <= actual_width )) || w=$((actual_width - x))
    (( y + h <= actual_height )) || h=$((actual_height - y))
    [ -n "$out" ] || out=$(new_capture_path zoom)
    mkdir -p "$(dirname "$out")"
    local frames
    frames=$(capture_settled "$out" "${w}x${h}" "${x},${y}")
    report_capture "$out" "$w" "$h" "$frames" " — region at native resolution"
}

# --- observation ------------------------------------------------------------------------------

# Reads the window list from the EWMH property the window manager maintains. wmctrl reads the same
# property but segfaults on an empty list, and xdotool and xprop are needed here regardless.
window_ids() {
    xprop -root _NET_CLIENT_LIST 2>/dev/null | sed 's/.*# //; s/,//g'
}

window_class() {
    xprop -id "$1" WM_CLASS 2>/dev/null | sed 's/.*, "//; s/".*//'
}

# The accessibility tree is read through AT-SPI, which has no shell binding; a small Python program
# walks it. It is given the geometry so that its boxes are in the same pixels as a screenshot, and
# the tree is then what coordinates refer to, as a screenshot would be.
command_tree() {
    local actual_width actual_height sent_width sent_height
    read -r actual_width actual_height sent_width sent_height < <(geometry)
    local arguments=("$actual_width" "$actual_height" "$sent_width" "$sent_height")
    $json && arguments+=(--json)
    "${DESKTOP_TREE:-/usr/local/libexec/agent-desktop-tree}" "${arguments[@]}" "$@"
    record_observed_geometry "$actual_width" "$actual_height" "$sent_width" "$sent_height"
}

command_windows() {
    local active id class title
    active=$(xdotool getactivewindow 2>/dev/null || echo 0)
    local actual_width actual_height sent_width sent_height addressed
    addressed=$(addressed_geometry)
    read -r actual_width actual_height sent_width sent_height <<<"$addressed"
    $json && printf '[\n'
    local first=true
    for id in $(window_ids); do
        # The eval below assigns every variable xdotool reports; declaring them keeps them local.
        # shellcheck disable=SC2034  # SCREEN is reported but not needed.
        local WINDOW X Y WIDTH HEIGHT SCREEN geometry
        # A window can close between listing and inspecting it; it is then simply not listed.
        geometry=$(xdotool getwindowgeometry --shell "$id" 2>/dev/null) || continue
        eval "$geometry"
        class=$(window_class "$id") || continue
        title=$(xdotool getwindowname "$id" 2>/dev/null || echo '')
        local x y w h
        x=$(to_display "$X" "$actual_width" "$sent_width")
        y=$(to_display "$Y" "$actual_height" "$sent_height")
        w=$(to_display "$WIDTH" "$actual_width" "$sent_width")
        h=$(to_display "$HEIGHT" "$actual_height" "$sent_height")
        if $json; then
            $first || printf ',\n'
            first=false
            printf '  {"id":"%s","active":%s,"x":%d,"y":%d,"width":%d,"height":%d,"class":"%s","title":%s}' \
                "$id" "$([ "$WINDOW" = "$active" ] && echo true || echo false)" \
                "$x" "$y" "$w" "$h" "$class" "$(printf '%s' "$title" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/')"
        else
            printf '%s %-22s %4d,%-4d %4dx%-4d %s%s\n' "$id" "${class:0:22}" "$x" "$y" "$w" "$h" \
                "$([ "$WINDOW" = "$active" ] && echo '* ' || echo '  ')" "$title"
        fi
    done
    $json && printf '\n]\n'
    return 0
}

command_cursor() {
    local x y actual_width actual_height sent_width sent_height addressed
    eval "$(xdotool getmouselocation --shell)"
    addressed=$(addressed_geometry)
    read -r actual_width actual_height sent_width sent_height <<<"$addressed"
    x=$(to_display "$X" "$actual_width" "$sent_width")
    y=$(to_display "$Y" "$actual_height" "$sent_height")
    if $json; then printf '{"x":%d,"y":%d}\n' "$x" "$y"; else printf '%d %d\n' "$x" "$y"; fi
}

command_display() {
    local actual_width actual_height sent_width sent_height query layout variant options
    read -r actual_width actual_height sent_width sent_height < <(geometry)
    query=$(setxkbmap -query) || fail "cannot read the keyboard layout of display $display"
    layout=$(sed -n 's/^layout: *//p' <<<"$query")
    variant=$(sed -n 's/^variant: *//p' <<<"$query")
    options=$(sed -n 's/^options: *//p' <<<"$query")
    local scale source
    scale=$(awk -v s="$sent_width" -v a="$actual_width" 'BEGIN { printf "%.2f", s / a }')
    # Where the budget came from: the settings that replaced it, or else the harness table.
    if [ ${#budget_overrides[@]} -gt 0 ]; then
        source=override
    else
        source=$budget_source
    fi
    if $json; then
        local overrides='' name
        for name in "${budget_overrides[@]}"; do overrides+=",\"$name\""; done
        printf '{"display":"%s","width":%d,"height":%d,"sentWidth":%d,"sentHeight":%d,"scale":%s,' \
            "$display" "$actual_width" "$actual_height" "$sent_width" "$sent_height" "$scale"
        printf '"budget":{"pixels":%s,"maxEdge":%s,"maxWidth":%s,"maxHeight":%s,"source":"%s","harness":%s,"overrides":[%s]},' \
            "${budget_pixels:-null}" "${budget_edge:-null}" "${budget_width:-null}" "${budget_height:-null}" \
            "$source" "$(json_string_or_null "$budget_harness")" "${overrides#,}"
        printf '"keyboard":{"layout":"%s","variant":"%s","options":"%s"}}\n' "$layout" "$variant" "$options"
    else
        printf 'display %s is %dx%d; screenshots are sent at %dx%d (%sx)\n' \
            "$display" "$actual_width" "$actual_height" "$sent_width" "$sent_height" "$scale"
        local limits='' from
        [ -z "$budget_pixels" ] || limits+=", $budget_pixels pixels"
        [ -z "$budget_edge" ] || limits+=", a $budget_edge px longest edge"
        [ -z "$budget_width" ] || limits+=", a ${budget_width}x${budget_height} box"
        case $budget_source in
            harness) from="for harness $budget_harness" ;;
            unknown) from="the default, for unknown harness '$budget_harness'" ;;
            *) from="the default, without AGENT_HARNESS" ;;
        esac
        if [ -n "$budget_width" ]; then
            from="set by ${budget_overrides[*]}"
        elif [ "$source" = override ]; then
            from="set by ${budget_overrides[*]}, otherwise $from"
        fi
        printf 'screenshot budget %s: %s\n' "${limits#, }" "$from"
        printf 'keyboard layout %s%s%s\n' "$layout" "${variant:+, variant $variant}" "${options:+, options $options}"
    fi
}

# A JSON string, or null for an empty value. AGENT_HARNESS comes from the environment, which
# anything may set, so it is escaped.
json_string_or_null() {
    [ -n "$1" ] || { echo null; return 0; }
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/[[:cntrl:]]//g; s/^/"/; s/$/"/'
}

# --- input ------------------------------------------------------------------------------------

# Blocks until the X server has processed everything sent before it, so the next command in a batch
# does not race the one before it. A request that needs a reply is a round trip by definition.
sync_x() { xdotool getactivewindow >/dev/null 2>&1 || true; }

move_pointer() {
    local actual_width actual_height sent_width sent_height x y addressed
    addressed=$(addressed_geometry)
    read -r actual_width actual_height sent_width sent_height <<<"$addressed"
    require_integer "$1" "x"; require_integer "$2" "y"
    x=$(to_display "$1" "$sent_width" "$actual_width")
    y=$(to_display "$2" "$sent_height" "$actual_height")
    xdotool mousemove -- "$x" "$y"
}

command_click() {
    local button=$1; shift
    local repeat=1
    case $button in triple) button=1; repeat=3 ;; double) button=1; repeat=2 ;; esac
    # Without coordinates the click lands where an earlier move put the pointer, on what was there.
    if [ $# -eq 2 ]; then move_pointer "$1" "$2"; elif [ $# -eq 0 ]; then addressed_geometry >/dev/null; else fail "click takes X and Y, or nothing"; fi
    xdotool click --repeat "$repeat" --delay 60 "$button"
    sync_x
}

command_move() { [ $# -eq 2 ] || fail "move takes X and Y"; move_pointer "$1" "$2"; sync_x; }

command_mouse_button() {
    local action=$1 button=${2:-1}
    require_integer "$button" "button"
    # A release is never refused, so that a resize cannot leave a button held.
    [ "$action" = mouseup ] || addressed_geometry >/dev/null
    xdotool "$action" "$button"
    sync_x
}

command_drag() {
    [ $# -eq 4 ] || fail "drag takes X1 Y1 X2 Y2"
    move_pointer "$1" "$2"
    xdotool mousedown 1
    # Intermediate motion: applications that track drags ignore a single jump.
    local actual_width actual_height sent_width sent_height step addressed
    addressed=$(addressed_geometry)
    read -r actual_width actual_height sent_width sent_height <<<"$addressed"
    for step in 1 2 3; do
        xdotool mousemove -- \
            "$(awk -v a="$1" -v b="$3" -v s="$step" -v sw="$sent_width" -v aw="$actual_width" \
                'BEGIN { printf "%d", int((a + (b - a) * s / 4) * aw / sw + 0.5) }')" \
            "$(awk -v a="$2" -v b="$4" -v s="$step" -v sh="$sent_height" -v ah="$actual_height" \
                'BEGIN { printf "%d", int((a + (b - a) * s / 4) * ah / sh + 0.5) }')"
    done
    move_pointer "$3" "$4"
    xdotool mouseup 1
    sync_x
}

command_scroll() {
    local direction=$1 steps=${2:-3} button
    require_integer "$steps" "scroll steps"
    case $direction in
        up) button=4 ;; down) button=5 ;; left) button=6 ;; right) button=7 ;;
        *) fail "scroll direction must be up, down, left or right" ;;
    esac
    # It scrolls what is under the pointer, which a resize may have moved.
    addressed_geometry >/dev/null
    xdotool click --repeat "$steps" --delay 40 "$button"
    sync_x
}

# xdotool binds a character the layout lacks to one level of a spare keycode, which X expands to a
# lower/upper pair, so ÆØÅ arrive as æøå. `type` binds such characters to both levels itself.
type_bound() {
    local text=$1; shift
    local -a bind=() unbind=()
    local binding cleanup='' pid status=0
    for binding in "$@"; do
        bind+=(-e "keycode ${binding% *} = ${binding#* } ${binding#* }")
        unbind+=(-e "keycode ${binding% *} =")
    done
    # An interrupted type must not leave keys bound or xdotool still typing.
    if [ ${#bind[@]} -gt 0 ]; then
        cleanup="xmodmap ${unbind[*]@Q} 2>/dev/null"
        # shellcheck disable=SC2064 # Expand the bindings now.
        trap "$cleanup" EXIT
        xmodmap "${bind[@]}" || fail "cannot bind keys on display $display"
    fi
    xdotool type --delay 12 -- "$text" &
    pid=$!
    # shellcheck disable=SC2064 # Expand the pid now.
    trap "kill $pid 2>/dev/null; $cleanup" EXIT
    wait "$pid" || status=$?
    [ ${#bind[@]} -eq 0 ] || xmodmap "${unbind[@]}"
    trap - EXIT
    return "$status"
}

command_type() {
    [ $# -ge 1 ] || fail "type takes the text to enter"
    local text=$* keymap type_lock
    # Concurrent types would pick the same spare keycodes.
    mkdir -p "$captures"
    exec {type_lock}>"$captures/.type.lock"
    flock "$type_lock"
    keymap=$(xmodmap -pk) || fail "cannot read the keyboard map of display $display"
    local -A present=() bound=()
    local keysym
    while read -r keysym; do present[$((keysym))]=1; done < <(grep -o '0x[0-9a-f]*' <<<"$keymap")
    # Unmapped keycodes, less one that xdotool binds itself.
    local -a spare
    mapfile -t spare < <(awk '$1 ~ /^[0-9]+$/ && NF == 1 { print $1 }' <<<"$keymap")
    local capacity=$((${#spare[@]} - 1))
    # Type in segments when the layout lacks more characters than there are spare keycodes.
    local -a bindings=()
    local segment='' character code index
    for ((index = 0; index < ${#text}; index++)); do
        character=${text:index:1}
        printf -v code '%d' "'$character"
        # xdotool maps control characters itself.
        if ((code >= 0x20 && (code < 0x7f || code >= 0xa0) && capacity > 0)); then
            keysym=$((code <= 0xff ? code : code | 0x1000000))
            if [ -z "${present[$keysym]:-}" ] && [ -z "${bound[$keysym]:-}" ]; then
                if [ ${#bindings[@]} -eq "$capacity" ]; then
                    type_bound "$segment" "${bindings[@]}"
                    segment='' bindings=() bound=()
                fi
                printf -v keysym '0x%x' "$keysym"
                bindings+=("${spare[${#bindings[@]}]} $keysym")
                bound[$((keysym))]=1
            fi
        fi
        segment+=$character
    done
    type_bound "$segment" "${bindings[@]}"
    sync_x
}

command_key() {
    local repeat=1 keys=()
    while [ $# -gt 0 ]; do
        case $1 in
            --repeat) repeat=${2:?--repeat needs a count}; shift 2 ;;
            *) keys+=("$1"); shift ;;
        esac
    done
    [ ${#keys[@]} -ge 1 ] || fail "key takes an X11 key combination such as ctrl+s or Page_Down"
    require_integer "$repeat" "--repeat"
    # --clearmodifiers releases modifiers a person or a stray keydown left pressed, but under
    # hold-key the held modifier is the point, so it is kept.
    local clear=(--clearmodifiers)
    [ -z "${DESKTOP_HOLDING:-}" ] || clear=()
    xdotool key "${clear[@]}" --repeat "$repeat" --delay 40 -- "${keys[@]}"
    sync_x
}

command_hold_key() {
    local keysym=$1; shift
    [ $# -ge 1 ] || fail "hold-key takes a keysym and a desktop command to run while it is held"
    xdotool keydown -- "$keysym"
    local status=0
    DESKTOP_HOLDING=$keysym run_command "$@" || status=$?
    xdotool keyup -- "$keysym"
    sync_x
    return "$status"
}

# --- windows and session ------------------------------------------------------------------------

command_focus() {
    [ $# -ge 1 ] || fail "focus takes a window id or a title substring"
    local target=$* id match=''
    case $target in
        0x*) match=$target ;;
        *)
            for id in $(window_ids); do
                local title; title=$(xdotool getwindowname "$id" 2>/dev/null || echo '')
                case ${title,,} in *"${target,,}"*) match=$id; break ;; esac
            done
            ;;
    esac
    [ -n "$match" ] || fail "no window matches '$target'"
    # Never --sync here: xdotool blocks indefinitely when the window manager declines the request.
    xdotool windowactivate "$match"
    sync_x
    echo "focused $match $(xdotool getwindowname "$match" 2>/dev/null || true)"
}

command_resize() {
    [ $# -eq 2 ] || fail "resize takes WIDTH and HEIGHT"
    require_integer "$1" "width"; require_integer "$2" "height"
    local output mode="$1x$2"
    output=$(xrandr | awk '/ connected/ { print $1; exit }')
    if ! xrandr --output "$output" --mode "$mode" 2>/dev/null; then
        fail "resize: $mode is not a mode of $output; available: $(xrandr | awk '/^ +[0-9]+x[0-9]+/ { printf "%s ", $1 }')"
    fi
    # A deliberate resize is not a surprise: coordinates follow the new geometry until the next
    # observation.
    rm -f "$observed_geometry"
    command_display
}

command_wait() {
    [ $# -eq 1 ] || fail "wait takes a number of seconds"
    case $1 in '' | *[!0-9.]*) fail "wait takes a number of seconds, got '$1'" ;; esac
    sleep "$1"
}

# --- batch ----------------------------------------------------------------------------------------

command_batch() {
    local screenshot=true
    while [ $# -gt 0 ]; do
        case $1 in
            --no-screenshot) screenshot=false; shift ;;
            *) fail "batch: unexpected argument '$1'" ;;
        esac
    done
    local -a lines=()
    local line
    while IFS= read -r line || [ -n "$line" ]; do lines+=("$line"); done
    local failed=false index=0
    for line in "${lines[@]}"; do
        index=$((index + 1))
        # A batch line is split on whitespace, with no quoting and no shell expansion: text a batch
        # line carries can come from the screen, and the screen is untrusted. The two commands whose
        # last argument is free text take the rest of the line verbatim instead.
        local -a words=()
        read -r -a words <<<"$line"
        # Blank lines, however indented, and comments are not actions.
        [ ${#words[@]} -gt 0 ] || continue
        [[ ${words[0]} != '#'* ]] || continue
        if $failed; then
            printf '%2d %s\n   Not executed: an earlier computer action in this turn failed.\n' "$index" "$line"
            continue
        fi
        printf '%2d %s\n' "$index" "$line"
        case ${words[0]} in
            type | focus)
                local rest=${line#*"${words[0]}"}
                rest=${rest# }
                # A bare `type` or `focus` has no argument, which the command itself refuses.
                if [ -n "$rest" ]; then words=("${words[0]}" "$rest"); else words=("${words[0]}"); fi
                ;;
        esac
        if ! run_command "${words[@]}" 2>&1 | sed 's/^/   /'; then failed=true; fi
    done
    if $screenshot; then command_screenshot; fi
    $failed && return 1
    return 0
}

# --- dispatch ---------------------------------------------------------------------------------

dispatch() {
    [ $# -ge 1 ] || { usage; return 64; }
    local command=$1; shift
    case $command in
        screenshot) command_screenshot "$@" ;;
        zoom) [ $# -ge 4 ] || fail "zoom takes X Y W H"; command_zoom "$@" ;;
        windows) command_windows ;;
        tree) command_tree "$@" ;;
        cursor) command_cursor ;;
        display) command_display ;;
        move) command_move "$@" ;;
        click) command_click 1 "$@" ;;
        right-click) command_click 3 "$@" ;;
        middle-click) command_click 2 "$@" ;;
        double-click) command_click double "$@" ;;
        triple-click) command_click triple "$@" ;;
        mouse-down) command_mouse_button mousedown "$@" ;;
        mouse-up) command_mouse_button mouseup "$@" ;;
        drag) command_drag "$@" ;;
        scroll) [ $# -ge 1 ] || fail "scroll takes a direction"; command_scroll "$@" ;;
        type) command_type "$@" ;;
        key) command_key "$@" ;;
        hold-key) [ $# -ge 2 ] || fail "hold-key takes a keysym and a command"; command_hold_key "$@" ;;
        focus) command_focus "$@" ;;
        resize) command_resize "$@" ;;
        wait) command_wait "$@" ;;
        batch) command_batch "$@" ;;
        help | --help | -h) usage ;;
        *) fail "unknown command '$command'; run 'desktop help'" ;;
    esac
}

# --json is a global option and is only recognized before the command, so that `type --json` and a
# batch line carrying the same text stay literal.
if [ "${1:-}" = --json ]; then json=true; shift; fi
budget
dispatch "$@"
