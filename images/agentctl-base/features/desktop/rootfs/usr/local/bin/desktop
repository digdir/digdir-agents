#!/usr/bin/python3 -I
"""Drives the agent's X11 desktop: observe it, point at it, type into it, record it. `desktop help` lists the commands.

The system Python, isolated from the environment's: `desktop tree` needs the AT-SPI bindings only it has.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'lib', 'agent-desktop'))

from agent_desktop.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
