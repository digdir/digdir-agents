#!/bin/sh
# An X11 desktop with VNC access, the `desktop` helpers and the computer-use skill; requires browser.
#
# Run by `agent-feature install desktop` as root, with a scratch HOME. The VNC access units ship disabled: agentd
# enables the ones /etc/agent-access.d/vnc.conf names when an Agent declares `access: [{type: vnc}]`.
set -eu

NOVNC_VERSION=${NOVNC_VERSION:-1.7.0}
NOVNC_SHA256=${NOVNC_SHA256:-b1003a11b6e6e8d8f7f5e5586daae7f8ca651d8aee0aa155ff9ac841c48f52c6}
WS_VERSION=${WS_VERSION:-8.21.3}

feature=$(dirname "$0")
# Agent Sandboxes mount their CA bundle here; this step's Node downloads trust it.
if [ -r /run/agent/tls/ca-bundle.pem ]; then
    export NODE_EXTRA_CA_CERTS=/run/agent/tls/ca-bundle.pem
fi

# A minimal X11 desktop: one process that is both X and VNC server, a window manager, a panel, the
# input and window tools the `desktop` helper uses, AT-SPI for `desktop tree`, and sakura as the
# terminal, whose text AT-SPI exposes too. xdg-utils lets `xdg-open`, and agentctl's open actions,
# open links in Chromium on the desktop. wmctrl is left out because its build here segfaults on an
# empty window list; the helper reads the same properties with xprop and xdotool.
apt-get update
apt-get install --yes --no-install-recommends \
    at-spi2-core \
    dbus-x11 \
    fonts-noto-color-emoji \
    fonts-noto-core \
    openbox \
    python3-pyatspi \
    sakura \
    tigervnc-standalone-server \
    tint2 \
    x11-utils \
    x11-xserver-utils \
    xdg-utils \
    xdotool
rm -rf /var/lib/apt/lists/*

# The browser viewer: noVNC, pinned by digest and trimmed to the files it serves, and `ws` for its
# WebSocket bridge. Neither is packaged for Ubuntu.
curl -fsSL "https://github.com/novnc/noVNC/archive/refs/tags/v${NOVNC_VERSION}.tar.gz" -o "${HOME}/novnc.tar.gz"
echo "${NOVNC_SHA256}  ${HOME}/novnc.tar.gz" | sha256sum -c -
install -d -m 0755 /usr/local/share/novnc
tar -xzf "${HOME}/novnc.tar.gz" -C /usr/local/share/novnc --strip-components=1 \
    "noVNC-${NOVNC_VERSION}/vnc.html" \
    "noVNC-${NOVNC_VERSION}/app" \
    "noVNC-${NOVNC_VERSION}/core" \
    "noVNC-${NOVNC_VERSION}/vendor" \
    "noVNC-${NOVNC_VERSION}/po" \
    "noVNC-${NOVNC_VERSION}/defaults.json" \
    "noVNC-${NOVNC_VERSION}/mandatory.json" \
    "noVNC-${NOVNC_VERSION}/package.json" \
    "noVNC-${NOVNC_VERSION}/LICENSE.txt"
npm install --global "ws@${WS_VERSION}"

# This feature's files, copied after the packages so that dpkg's own openbox and tint2 configuration does not ask
# whether to keep them.
cp -R "${feature}/rootfs/." /

for skills in /home/agent/.claude/skills /home/agent/.agents/skills; do
    rm -rf "${skills}/computer-use"
    cp -R "${feature}/skills/computer-use" "${skills}/computer-use"
    chown -R agent:agent "${skills}/computer-use"
done

systemctl enable agent-desktop-display.service agent-desktop-session.service agent-desktop-dbus.service

# The desktop's configuration, its units and the environment the image sets must agree.
# shellcheck source=/dev/null
. /etc/agent-desktop.conf
grep -qxF "DISPLAY=${AGENT_DESKTOP_DISPLAY}" "${feature}/env" \
    || { echo "${feature}/env does not set DISPLAY=${AGENT_DESKTOP_DISPLAY}" >&2; exit 1; }
vnc_port="$(sed -n 's/^port=//p' /etc/agent-access.d/vnc.conf)"
web_port="$(sed -n 's/^web-port=//p' /etc/agent-access.d/vnc.conf)"
grep -qxF "ListenStream=127.0.0.1:${vnc_port}" /etc/systemd/system/agent-vnc.socket \
    || { echo "agent-vnc.socket does not listen on the descriptor's port ${vnc_port}" >&2; exit 1; }
grep -qxF "Environment=AGENT_NOVNC_PORT=${web_port}" /etc/systemd/system/agent-vnc-web.service \
    || { echo "agent-vnc-web.service does not serve the descriptor's web-port ${web_port}" >&2; exit 1; }

Xtigervnc -version >/dev/null 2>&1
openbox --version >/dev/null
tint2 --version
xdotool --version
command -v sakura >/dev/null
node -e "require('/usr/local/lib/node_modules/ws')"
test -f /usr/local/share/novnc/vnc.html
python3 -c 'import pyatspi'
test -f /usr/share/dbus-1/services/org.a11y.Bus.service
AGENT_BROWSER_CA_READY_FILE=/dev/null chromium --version
/usr/local/libexec/agent-playwright-chromium --headless --version
desktop help >/dev/null
test "$(xdg-mime query default x-scheme-handler/https)" = chromium.desktop
command -v ss >/dev/null
