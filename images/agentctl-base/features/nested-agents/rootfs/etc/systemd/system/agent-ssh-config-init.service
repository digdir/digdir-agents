[Unit]
Description=Include nested Agents' SSH aliases in the agent user's SSH configuration
# agentctl's installer uses ~/.local/bin; an image may install it in /usr/local/bin.
ConditionFileIsExecutable=|/home/agent/.local/bin/agentctl
ConditionFileIsExecutable=|/usr/local/bin/agentctl

[Service]
Type=oneshot
# Stays active, so that agent-ssh-config-init.path does not start it again.
RemainAfterExit=yes
User=agent
Group=agent
Environment=PATH=/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c 'exec agentctl ssh-config install'

[Install]
WantedBy=multi-user.target
