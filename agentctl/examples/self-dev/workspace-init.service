[Unit]
Description=Initialize the Agent workspace checkout
Wants=network-online.target
After=network-online.target

[Service]
# Best-effort clones started at boot; a bind-mounted checkout already has `.git`, so the script
# leaves it alone. `Type=exec` completes the start job once the
# script has been started, keeping the clone out of the boot transaction so that
# `systemctl is-system-running --wait` does not wait for it.
Type=exec
User=agent
Group=agent
Environment=HOME=/home/agent
PassEnvironment=GITHUB_TOKEN
ExecStart=/usr/local/libexec/agent-workspace-init

[Install]
WantedBy=multi-user.target
