{
  "consumers": {
    "integrations-router": {
      "keys": ["integrations-router"],
      "rules": [
        { "pathSuffix": "/embeddings", "upstream": "lmstudio", "model": "text-embedding-qwen3-embedding-4b" },
        { "upstream": "aivar", "model": "aivar:gemma4" }
      ]
    },
    "proxy-agent": {
      "keys": ["proxy-agent", "none"],
      "rules": [
        { "upstream": "aivar", "model": "aivar:gemma4" }
      ]
    },
    "jr-developer": {
      "keys": ["jr-developer"],
      "rules": [
        { "upstream": "anthropic", "appendHeaders": { "anthropic-beta": "oauth-2025-04-20" } }
      ]
    },
    "sr-developer": {
      "keys": ["sr-developer"],
      "rules": [
        { "upstream": "anthropic", "appendHeaders": { "anthropic-beta": "oauth-2025-04-20" } }
      ]
    }
  }
}
