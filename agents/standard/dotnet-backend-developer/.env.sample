# Copy this file to .env beside it and fill it in. `agentctl apply` reads .env, and Git ignores it.

# Enter the sandbox as they are.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Stays on the host. A fine-grained personal access token with Contents, Pull requests and Workflows read and
# write on your repositories. Optional: without it the agent works on public repositories only, and cannot push.
GITHUB_TOKEN=
