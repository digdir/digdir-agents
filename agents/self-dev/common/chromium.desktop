[Desktop Entry]
Type=Application
Name=Chromium
Comment=The desktop's browser, the same Playwright Chromium build playwright-cli drives
Exec=/usr/local/libexec/agent-browser-open %U
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
