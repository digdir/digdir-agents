# Kopiér til .env (gitignorert). Verdiene forblir på hosten: sandboxen ser
# placeholders, og hosten substituerer kun i trafikk mot allowedHosts.

# Commit-identitet (settes opp som global git-config i sandboxen)
GIT_USER_NAME=
GIT_USER_EMAIL=

# Fine-grained PAT avgrenset til repoene jr jobber i:
# Contents: Read and write, Pull requests: Read and write (+ Actions: Read
# for CI-innsyn). IKKE det klassiske delte agent-PAT-et.
GITHUB_TOKEN=
